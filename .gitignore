# Public source allowlist. Local research, SDKs, artwork and releases stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/NOTICE.md
!/src/
!/mod/
!/scripts/
!/tests/
/mod/*
!/mod/src/
!/mod/content/
!/mod/Yinch.CelesteMovement.csproj
!/mod/manifest.json
!/mod/global.json
!/mod/packages.lock.json
!/mod/dtmapi.author.example.json
/scripts/*
!/scripts/Build.ps1
!/scripts/Manage-Mod.ps1
/tests/*
!/tests/MovementTests/
**/bin/
**/obj/
**/dist/
**/.dtmapi/
**/*.user
**/*.log
**/.env*
**/local.settings.json
